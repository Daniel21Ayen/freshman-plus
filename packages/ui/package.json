{
  "name": "@freshman-plus/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform primitives built on the design tokens",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@freshman-plus/ui-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "18.3.1",
    "react-native": "0.76.5"
  }
}
