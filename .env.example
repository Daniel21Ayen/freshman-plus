# ───────── Shared ─────────
NODE_ENV=development

# ───────── Database (packages/database) ─────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freshman_plus?schema=public
SEED_ADMIN_EMAIL=admin@freshmanplus.et
SEED_ADMIN_PASSWORD=change-me-before-seeding

# ───────── API (apps/api) ─────────
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-32+char-random-string
JWT_REFRESH_SECRET=replace-with-another-32+char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
REDIS_URL=redis://localhost:6379

# File storage (payment screenshots, exam PDFs, notes)
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OCR (admin exam upload)
OCR_PROVIDER=tesseract          # tesseract | google-vision
GOOGLE_VISION_API_KEY=

# Optional payment gateways (manual screenshot flow needs none of these)
CHAPA_SECRET_KEY=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=

# ───────── Admin web (apps/admin-web) ─────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-random-string

# ───────── Mobile (apps/mobile) ─────────
# Android emulator reaches host machine at 10.0.2.2
MOBILE_API_URL=http://10.0.2.2:4000
